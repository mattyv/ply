// A kitchen-sink program: every production of the Ply grammar (§5.2) appears at least once.
// The file is kept canonically formatted, so the corpus harness also covers `ply fmt`.

use orders;
use pricing;

/* Block comments are preserved as written,
   including their continuation lines. */
struct Money {
    amount: Int,
    currency: String,
}

struct Pair[A, B] {
    left: A,
    // Fields may carry comments.
    right: B, // including trailing ones
}

struct Empty {}

struct Invoice {
    id: Int,
    customer_id: Int,
    amount: Int,
    days_late: Int,
}

struct Customer {
    id: Int,
    name: String,
}

struct Overdue {
    customer: Int,
    total: Int,
    n: Int,
}

enum Shape {
    Circle(Int),
    Rect(Int, Int),
    Nothing,
}

enum Tree[T] {
    Leaf,
    Node(T, Tree[T], Tree[T]),
}

fn identity[T](value: T) -> T {
    value
}

fn add(a: Int, b: Int) -> Int
    requires a >= 0
    requires b >= 0
    ensures |r| r >= a
    verify bounded(depth: 2)
{
    a + b
}

fn gcd(a: Int, b: Int) -> Int
    requires a > 0
    requires b >= 0
    decreases b
    verify prove
{
    if b == 0 {
        a
    } else {
        gcd(b, a % b)
    }
}

fn sum_to(n: Int) -> Int
    requires n >= 0
    ensures |r| r >= 0
    verify induct(k: 2)
{
    let mut total = 0;
    let mut i = 0;
    while i < n
        invariant i >= 0
        invariant total >= 0
        decreases n - i
    {
        total = total + i;
        i = i + 1;
    }
    total
}

fn greet(name: String) -> ()
    uses { io.write }
{
    print("hello " + name);
}

fn remember(key: String, value: String) -> Option[String]
    uses { db.read, db.write }
{
    db_put(key, value);
    db_get(key)
}

fn ask() -> String
    uses { io.read }
{
    read_line()
}

fn stamp() -> Int
    uses { rand, time }
    verify fuzz(runs: 64)
{
    now() + rand_int(0, 10)
}

fn pure_by_declaration() -> Int
    uses {}
    verify test
{
    0
}

fn peek(xs: &List[Int]) -> Int {
    xs[0]
}

fn mutate(m: &mut Money, xs: &mut List[Int]) -> () {
    m.amount = m.amount + 1;
    xs[0] = 2;
}

fn classify(xs: List[Option[Int]]) -> Int {
    let mut seen = 0;
    for x in xs {
        let v = match x {
            Some(0) => 0,
            Some(v) => v,
            None => -1,
        };
        seen = seen + v;
    }
    seen
}

fn describe(s: Shape) -> String {
    match s {
        Circle(r) => "circle",
        Rect(w, h) => "rect",
        Nothing => "nothing",
    }
}

fn amount_of(m: Money) -> Int {
    match m {
        { amount, currency: unit } => amount,
    }
}

fn early(a: Int) -> Int {
    if a < 0 {
        return 0;
    }
    a
}

fn expressions(a: Int, b: Int, c: Bool) -> Int {
    let arithmetic = a + b * 2 - a / 2 % 3;
    let comparison = a < b;
    let logic = c and not c or comparison;
    let grouped = (a + b) * (a - b);
    let negated = -a;
    let numbers = [1, 2, 3];
    let nested = [[1], [], [2, 3]];
    let money = Money { amount: a, currency: "EUR" };
    let field = money.amount;
    let indexed = numbers[0];
    let called = identity[Int](a);
    let sugared = money.amount.max(b);
    let text = "escapes: \n \t \\ \" \u{7}";
    let inner = {
        let half = a / 2;
        half + 1
    };
    let branch = if a > b {
        a
    } else if a < b {
        b
    } else {
        0
    };
    arithmetic + negated + inner + branch + field + indexed + called + sugared
}

fn pending(a: Int) -> Int
    ensures |r| r >= 0
{
    if a > 0 {
        unresolved #1
    } else {
        dontcare
    }
}

fn recent(xs: List[Invoice]) -> List[Invoice] {
    query { from i in xs where i.days_late > 0 select i }
}

fn overdue(invoices: List[Invoice], customers: List[Customer]) -> List[Overdue] {
    query {
        from i in invoices,
        from c in customers
        where i.customer_id == c.id and i.days_late > 30
        group i by i.customer_id into g
        select Overdue { customer: g.key, total: sum(g, .amount), n: count(g) }
        order by g.key desc
        hint(prefer: hash_join)
    }
}

rules AccessControl {
    rel parent(String, String);
    rel blocked(String);
    ancestor(x, y) :- parent(x, y);
    ancestor(x, z) :- parent(x, y), ancestor(y, z);
    allowed(x) :- ancestor(x, "root"), not blocked(x), x != "nobody";
}

machine OrderLifecycle {
    states Draft -> Placed -> Filled | Cancelled;
    Placed -> Cancelled when not ev.partially_filled;
    invariant: true;
}

example add(1, 2) == 3;
example identity(7) == 7;
