    "items": {
      "sit-1": {
        "id": "sit-1",
        "entityRef": null,
        "question": "Why can't Kani verify Ply's targets, and does routing bounded checks to Kani survive contact with real code?",
        "status": "open",
        "createdAt": 1787492636508,
        "resolvedAt": null,
        "resolution": null,
        "hypotheses": [
          {
            "id": "other",
            "statement": "The true explanation is not in the current candidate set",
            "prior": 0.15,
            "posterior": 0.05,
            "status": "active",
            "predictedEvidence": [],
            "generation": 0
          },
          {
            "id": "h-1",
            "statement": "Heap-allocating std collections (BTreeSet/Vec/String) are the specific blocker: CBMC symbolically unwinds their generic allocation/clone/sort algorithms, and code avoiding them verifies fine",
            "prior": 0.2975,
            "posterior": 0.8587168355295806,
            "status": "active",
            "predictedEvidence": [
              "scalar and small-struct targets verify in ~0.1s",
              "replacing BTreeSet with a bitmask changes the failure mode",
              "fixed-size arrays verify where Vec of the same length does not",
              "the stall trace names collection internals like clone_subtree or median3_rec"
            ],
            "generation": 0
          },
          {
            "id": "h-2",
            "statement": "Our harnesses are written wrong (unbounded symbolic length, missing kani::any_vec, missing unwind bounds), so this is a fixture defect not a Kani limit",
            "prior": 0.17,
            "posterior": 0.036996870464993295,
            "status": "active",
            "predictedEvidence": [
              "a Vec bounded to length 1 still times out, which is absurd for a genuine capability limit",
              "using Kanis dedicated bounded-collection helpers fixes it",
              "the same shape verifies when constructed differently"
            ],
            "generation": 0
          },
          {
            "id": "h-3",
            "statement": "Recursion in the target is the real cost driver, independent of collections: CBMC cannot bound recursive descent through a tree structure",
            "prior": 0.1275,
            "posterior": 0.04612276517969162,
            "status": "active",
            "predictedEvidence": [
              "a single leaf verifies but one level of recursion does not",
              "depth 1 vs 2 vs 3 shows a sharp cliff",
              "non-recursive collection code verifies fine"
            ],
            "generation": 0
          },
          {
            "id": "h-4",
            "statement": "Bounded model checking simply does not scale to ordinary Rust at all: any target beyond toy scalars is intractable regardless of shape, and routing bounded to Kani is unviable as designed",
            "prior": 0.1275,
            "posterior": 0.00030926176549684795,
            "status": "active",
            "predictedEvidence": [
              "fixed-size arrays time out too, not just Vec",
              "Option/Result of scalars are already slow",
              "no configuration (unwind, solver, object-bits) helps anywhere"
            ],
            "generation": 0
          },
          {
            "id": "h-5",
            "statement": "It is a configuration and flag problem: the right unwind bounds, solver choice, or stubbing makes these targets tractable and we have not found the recipe",
            "prior": 0.1275,
            "posterior": 0.007854267060237409,
            "status": "active",
            "predictedEvidence": [
              "a solver swap or object-bits change flips a timeout to verified",
              "Kani docs name a supported recipe we have not applied",
              "-Z stubbing of collection ops makes the kernel provable"
            ],
            "generation": 0
          }
        ],
