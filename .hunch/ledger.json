            "text": "Fixed-size arrays [T;N] verify cheaply at every N up to 16 with NO unwind annotation needed, because the bound is a compile-time constant",
            "timestamp": 1787494479328,
            "provenance": {
              "sourceType": "firsthand",
              "reliability": 1.0,
              "sourceRef": null
            },
            "clusterId": "c-8",
